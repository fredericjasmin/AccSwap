<Window
    x:Class="GLAS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:GLAS.App.Localization"
    xmlns:vm="clr-namespace:GLAS.App.ViewModels"
    Title="GLAS - Game Launcher Account Switcher"
    Width="980"
    Height="640"
    MinWidth="760"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource WindowBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="AccountCard" DataType="{x:Type vm:AccountItemViewModel}">
            <Border
                Width="224"
                Margin="0,2,12,12"
                Padding="18,16"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="46"
                            Height="46"
                            CornerRadius="23">
                            <Border.Background>
                                <SolidColorBrush Color="#2A2F38" />
                            </Border.Background>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="{Binding Initials}" />
                        </Border>

                        <TextBlock
                            Grid.Column="2"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Success}"
                            Padding="8,3"
                            Text="{Binding [Account.Active], Source={x:Static loc:Loc.Instance}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock
                        Margin="0,12,0,4"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Style="{StaticResource CardText}"
                        Text="{Binding Name}"
                        ToolTip="{Binding Name}" />

                    <TextBlock
                        Margin="0,0,0,14"
                        FontSize="11"
                        Foreground="#6C727B"
                        Style="{StaticResource CardText}"
                        Text="{Binding CreatedText}" />

                    <!-- Switch action full width, secondary actions split
                         50/50: all buttons always fit, no clipped edges. -->
                    <Button
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Content="{Binding [Account.Switch], Source={x:Static loc:Loc.Instance}}"
                        IsEnabled="{Binding IsSwitchable}"
                        Style="{StaticResource PrimaryButton}" />

                    <UniformGrid Columns="2">
                        <Button
                            Margin="0,0,6,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{Binding [Account.Rename], Source={x:Static loc:Loc.Instance}}"
                            Style="{StaticResource GhostButton}" />
                        <Button
                            Margin="6,0,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{Binding [Account.Delete], Source={x:Static loc:Loc.Instance}}"
                            Style="{StaticResource DangerGhostButton}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,24">
                    <TextBlock FontSize="24" FontWeight="Bold" Text="GLAS" />
                    <TextBlock
                        FontSize="11"
                        Foreground="#6C727B"
                        Text="{Binding [App.Version], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>

                <!-- General actions pinned to the bottom -->
                <StackPanel
                    DockPanel.Dock="Bottom"
                    Margin="12,0,12,14">
                    <Separator
                        Margin="6,0,6,10"
                        Background="{StaticResource CardBorder}" />
                    <Button
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ExportCommand}"
                        Content="{Binding [Toolbar.Export], Source={x:Static loc:Loc.Instance}}"
                        Style="{StaticResource GhostButton}" />
                    <Button
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ImportCommand}"
                        Content="{Binding [Toolbar.Import], Source={x:Static loc:Loc.Instance}}"
                        Style="{StaticResource GhostButton}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{Binding OpenSettingsCommand}"
                        Content="{Binding [Toolbar.Settings], Source={x:Static loc:Loc.Instance}}"
                        Style="{StaticResource GhostButton}" />
                </StackPanel>

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SidebarItem}"
                    ItemsSource="{Binding Platforms}"
                    SelectedItem="{Binding SelectedPlatform}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding Accent}"
                                    CornerRadius="11">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#10131A"
                                        Text="{Binding Glyph}" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <DockPanel Grid.Column="1" Margin="26,20,26,16">

            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedPlatform.Name}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding AddAccountCommand}"
                        Content="{Binding [Toolbar.AddAccount], Source={x:Static loc:Loc.Instance}}"
                        Style="{StaticResource PrimaryButton}" />
                    <Button
                        Command="{Binding SaveCurrentSessionCommand}"
                        Content="{Binding [Toolbar.SaveCurrent], Source={x:Static loc:Loc.Instance}}"
                        Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>

            <!-- Overlays + account cards share the fill area so the empty
                 states truly center in both axes. -->
            <Grid>
                <!-- Account cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Margin="0,14,0,4"
                        ItemTemplate="{StaticResource AccountCard}"
                        ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Not installed -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAccounts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{Binding [Accounts.NotInstalled.Title], Source={x:Static loc:Loc.Instance}}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondary}"
                        MaxWidth="420"
                        Text="{Binding EmptyBody}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Empty state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowAccounts}" Value="True" />
                                        <Condition Binding="{Binding HasAccounts}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{Binding EmptyTitle}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondary}"
                        MaxWidth="420"
                        Text="{Binding EmptyBody}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
